worker_processes 1;
pid /tmp/pokemoniv-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 128; }
http {
    # Do not log request URLs, query strings, authorization or cookies.
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/pokemoniv-nginx/body;
    proxy_temp_path /tmp/pokemoniv-nginx/proxy;
    fastcgi_temp_path /tmp/pokemoniv-nginx/fastcgi;
    uwsgi_temp_path /tmp/pokemoniv-nginx/uwsgi;
    scgi_temp_path /tmp/pokemoniv-nginx/scgi;
    limit_conn_zone $server_name zone=global_connections:64k;
    limit_req_zone $server_name zone=global_requests:64k rate=10r/s;
    # The edge peer is used; never trust client-supplied X-Forwarded-For.
    limit_req_zone $binary_remote_addr zone=peer_requests:64k rate=10r/s;
    limit_req_status 429;
    limit_conn_status 503;
    server {
        listen __PORT__;
        server_name _;
        client_header_timeout 10s;
        client_body_timeout 10s;
        send_timeout 15s;
        keepalive_timeout 5s;
        keepalive_requests 50;
        reset_timedout_connection on;
        client_max_body_size 23m;
        large_client_header_buffers 2 8k;
        limit_conn global_connections 24;
        proxy_connect_timeout 2s;
        proxy_send_timeout 20s;
        proxy_read_timeout 80s;
        # Stream only length-delimited requests into the app's absolute body timer.
        # Buffering here would let a byte-trickling upload occupy a slot indefinitely.
        if ($http_transfer_encoding != "") { return 400; }
        proxy_request_buffering off;
        proxy_buffering on;
        proxy_max_temp_file_size 32m;
        proxy_http_version 1.0;
        proxy_set_header Connection close;
        proxy_set_header Host $host;
        # Bound spoofed IP data and keep it out of application authorization.
        proxy_set_header X-Forwarded-For $remote_addr;
        location = /health { proxy_pass http://127.0.0.1:8788; }
        location / {
            limit_req zone=global_requests burst=40 nodelay;
            limit_req zone=peer_requests burst=40 nodelay;
            proxy_pass http://127.0.0.1:8788;
        }
    }
}
